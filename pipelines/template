- task: AzureCLI@2
      displayName: 'Deploy to Slot (0% Traffic) & Run Health Check'
      inputs:
        azureSubscription: '${{ parameters.azureServiceConnection }}'
        scriptType: bash
        scriptLocation: inlineScript
        inlineScript: |
          SLOT_NAME="staging"
          WEBAPP="${{ parameters.webApp }}"
          RG="${{ parameters.resourceGroup }}"

          az account set --subscription "${{ parameters.subscriptionId }}"

          # 1. Create staging slot if it doesn't exist
          az webapp deployment slot create \
            --resource-group $RG \
            --name $WEBAPP \
            --slot $SLOT_NAME

          # 2. Ensure initial traffic routing to staging is 0%
          az webapp traffic-routing set \
            --resource-group $RG \
            --name $WEBAPP \
            --distribution $SLOT_NAME=0

          # 3. Deploy container image to the STAGING SLOT
          az webapp config container set \
            --resource-group $RG \
            --name $WEBAPP \
            --slot $SLOT_NAME \
            --container-image-name "$(fullImage)"

          # 4. Set App Settings on the STAGING SLOT
          az webapp config appsettings set \
            --resource-group $RG \
            --name $WEBAPP \
            --slot $SLOT_NAME \
            --settings \
              AAD_CLIENT_ID=${{ parameters.AAD_CLIENT_ID }} \
              AAD_CLIENT_SECRET=${{ parameters.AAD_CLIENT_SECRET }} \
              AAD_TENANT_ID=${{ parameters.AAD_TENANT_ID }} \
              AAD_REDIRECT_URI=${{ parameters.AAD_REDIRECT_URI }} \
              AAD_LOGIN_SCOPES=${{ parameters.AAD_LOGIN_SCOPES }} \
              BACKEND_SCOPES=${{ parameters.BACKEND_SCOPES }} \
              POST_LOGIN_REDIRECT=${{ parameters.POST_LOGIN_REDIRECT }} \
              BACKEND_URL=${{ parameters.BACKEND_URL }} \
              KEY_VAULT=${{ parameters.KEY_VAULT }}

          # 5. Fetch Direct Slot FQDN for isolated testing
          SLOT_FQDN=$(az webapp deployment slot show \
            --resource-group $RG \
            --name $WEBAPP \
            --slot $SLOT_NAME \
            --query "defaultHostName" -o tsv)

          echo "Direct Staging URL: https://$SLOT_FQDN"
          echo "##vso[task.setvariable variable=slotFqdn]$SLOT_FQDN"

          # 6. Health check on 0% traffic direct slot FQDN
          echo "Running health check on slot..."
          curl -f -I "https://$SLOT_FQDN/health" || { echo "❌ Slot health check failed"; exit 1; }

    # OPTIONAL: Place your ZAP Scan Task here targeting https://$(slotFqdn)

    - task: AzureCLI@2
      displayName: 'Divert 20% Traffic & Monitor'
      inputs:
        azureSubscription: '${{ parameters.azureServiceConnection }}'
        scriptType: bash
        scriptLocation: inlineScript
        inlineScript: |
          SLOT_NAME="staging"
          WEBAPP="${{ parameters.webApp }}"
          RG="${{ parameters.resourceGroup }}"

          echo "Diverting 20% traffic to $SLOT_NAME slot..."
          az webapp traffic-routing set \
            --resource-group $RG \
            --name $WEBAPP \
            --distribution $SLOT_NAME=20

          # Allow app to warm up under 20% load
          sleep 15

          # Health check main production URL
          echo "Checking health on main domain..."
          curl -f -I "https://$WEBAPP.azurewebsites.net/health" || {
            echo "❌ 20% rollout health check failed! Executing rollback..."
            az webapp traffic-routing clear --resource-group $RG --name $WEBAPP
            exit 1
          }

    - task: AzureCLI@2
      displayName: 'Promote 100% Traffic (Slot Swap)'
      inputs:
        azureSubscription: '${{ parameters.azureServiceConnection }}'
        scriptType: bash
        scriptLocation: inlineScript
        inlineScript: |
          SLOT_NAME="staging"
          WEBAPP="${{ parameters.webApp }}"
          RG="${{ parameters.resourceGroup }}"

          echo "Swapping $SLOT_NAME slot to production..."
          az webapp deployment slot swap \
            --resource-group $RG \
            --name $WEBAPP \
            --slot $SLOT_NAME \
            --target-slot production

          echo "✅ Production deployment complete!"
