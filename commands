  - ${{ if or(eq(variables['Build.Reason'], 'BuildCompletion'), eq(variables['Build.Reason'], 'ResourceTrigger')) }}:
    - group: backend-text-dev

  # Scenario 2: PR opened targeting 'uat'
  - ${{ if and(eq(variables['Build.Reason'], 'PullRequest'), eq(variables['System.PullRequest.TargetBranch'], 'refs/heads/uat')) }}:
    - group: backend-text-uat



  # Scenario 3: PR opened targeting 'main'
  - ${{ if and(eq(variables['Build.Reason'], 'PullRequest'), eq(variables['System.PullRequest.TargetBranch'], 'refs/heads/main')) }}:
