# Copy this file to .env and fill in your values.

# Found on your Foundry project's Overview page, "Project details" section.
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=https://txrh-foundry.services.ai.azure.com/api/projects/txrh-project
# The Agent ID of the agent you already deployed/created in Foundry (looks like asst_xxxxxxxx).
# Find it in Foundry Portal -> Agents -> your agent -> Overview.
AGENT_ID=txrh-demoagent-2

# Optional: port the API listens on
PORT=8000
